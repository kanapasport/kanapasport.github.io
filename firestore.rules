rules_version = '2';

// ============================================================================
// Pravidla pro Firestore – Pasport Kaňa
//
// TENHLE SOUBOR SE SÁM NIKAM NENASADÍ. Push na GitHub ho jen uloží –
// platit začne, až se celý vloží ve Firebase Console → Firestore Database
// → Rules → Publish. Po každé změně tady ho tam vlož znovu, ať konzole
// a soubor nejsou každý jiný.
//
// Web se přihlašuje přes Firebase Auth (e-mail + heslo), role čtou pravidla
// z public/data/users/{uid}. Soubor je ve veřejném repu – žádné e-maily,
// jména ani tajné údaje do komentářů.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function zaznam() {
      return /databases/$(database)/documents/artifacts/firemni-kb-app/public/data/users/$(request.auth.uid);
    }

    // Samotné přihlášení nestačí. Firebase nikomu nebrání si účet vytvořit
    // (klíč je ve zdroji stránky), takže se musí ověřit, že je člověk
    // opravdu v seznamu a že mu účet není pozastavený. Bez záznamu se
    // nedostane ani ke čtení.
    function clen() {
      return request.auth != null
        && exists(zaznam())
        && get(zaznam()).data.active != false;
    }

    function role() {
      return get(zaznam()).data.role;
    }

    function spravce() {
      // majitel a asistentka mají zatím práva manažera (21. 8.)
      return clen() && role() in ['hlavni-spravce', 'majitel', 'spravce', 'asistentka'];
    }

    function hlavniSpravce() {
      return clen() && role() == 'hlavni-spravce';
    }

    /* TYP SPOLUPRÁCE. Stejné odvození jako na webu (UI.typUvazku): kdo ho
       nemá vyplněný, je student podle role, jinak zaměstnanec. */
    function typSpoluprace() {
      return get(zaznam()).data.get('typ', '') != ''
        ? get(zaznam()).data.get('typ', '')
        : (role() == 'student' ? 'student' : 'zamestnanec');
    }

    /* Kdo si práci fakturuje sám. Zaměstnanec má domluvenou měsíční
       výplatu a hodinovka mu nic neříká; OSVČ a student na dohodu si
       podle odpracovaných hodin píšou fakturu, takže musí vidět, kolik
       jim za ně vychází (Michal 2. 9. 2026). Dohody DPP a DPČ jsou na tom
       stejně jako student na dohodu (Michal 3. 11. 2026). */
    function fakturujeSi() {
      return clen() && typSpoluprace() in ['osvc', 'dpp', 'dpc', 'student'];
    }

    /* Účet, pod kterým běží Apps Script – v seznamu lidí má typ
       spolupráce „servis". Není to člověk: píše hodiny do Tabulek
       a rozesílá upozornění na e-mail. Právo se schválně váže na TYP,
       ne na roli – manažer je pořád člověk a ten se k cizím vzkazům
       nedostane. (Repozitář je veřejný, adresa účtu sem nepatří.) */
    function rozesilac() {
      return clen() && typSpoluprace() == 'servis';
    }

    /* ROBOT (audit 10. 11. 2026, Michal 12. 11. 2026, Iris – A3-06). Servisní
       účty (Apps Script, nástroje na PC přes kb_api.py) dnes mají roli
       `spravce`, a tím i všechna manažerská práva. Role `robot` jim má dát
       jen to, co opravdu dělají: číst `private` (kromě faktur, pokladny,
       výplat a uzávěrek – ty mají vlastní pravidla), psát částky, stavy
       zápisu do Tabulek, upozornění, číselníky, projekty, úkoly, fotky BPH,
       vybavení a dva dokumenty `meta` (upozorneni, zakazky). Kalendář,
       výkazy, vzkazy ani lidi neměnit. Zatím jen PŘIDÁVÁ – role účtů se
       přepne až po kontrole; do té doby platí spravce(). */
    function robot() {
      return clen() && role() == 'robot';
    }

    /* --- KDO CO POTVRZUJE (Michal 3. 11. 2026, model A „tvrdě") ----------
       V Nastavení → Potvrzování hlavní správce u každého druhu zaškrtne, kteří
       manažeři ho potvrzují – stejně pro všechny lidi:

         private/potvrzovani/nastaveni/hlavni
           { druhy: { nepritomnosti: { lide: [uid…] }, ukoly: { lide },
                      milniky: { lide }, zpetne: { lide } }, updatedMs, updatedBy }

       Prázdný seznam druhu (nebo chybějící dokument) = platí dřívější stav –
       potvrdí každý, komu pravidlo dokumentu dovolí ho měnit. Vyplněný =
       potvrdí jen hlavní správce a manažer ze seznamu (kdo už manažer není,
       tomu zaškrtnutí nepomůže). „Potvrdit" tady znamená změnit záznam
       z nepotvrzeného na potvrzený; zrušení potvrzení a úpravy, které
       potvrzení jen nesou dál beze změny, hlídané nejsou.
       Od 3. 11. 2026 (Iris) stejně i ODMÍTNUTÍ: zamítnutí nepřítomnosti
       (`zamitnuto` z ne na ano), vrácení cizího hotového úkolu do práce
       a zrušení splnění cizího milníku (kdo není přiřazený / zpracovatel).
       Čte se jeden dokument navíc. Opakované get() téhož dokumentu v jednom
       požadavku se znovu nepočítá (stejně jako get(zaznam()) v clen/role),
       takže na jeden zápis jsou nejvýš 3 různé dokumenty (člověk, nastavení,
       zdrojová událost / milník) – limit přístupů (10, v dávce 20) je daleko. */
    function potvrzovaniCesta() {
      return /databases/$(database)/documents/artifacts/firemni-kb-app/private/potvrzovani/nastaveni/hlavni;
    }
    // určení lidé k druhu, jak leží v dokumentu; [] = nikdo určený není
    function urceni(druh) {
      return exists(potvrzovaniCesta())
        ? get(potvrzovaniCesta()).data.get('druhy', {}).get(druh, {}).get('lide', [])
        : [];
    }
    function smiPotvrdit(druh) {
      return hlavniSpravce()
        || !(urceni(druh) is list)
        || urceni(druh).size() == 0
        || (spravce() && request.auth.uid in urceni(druh));
    }
    /* Splněný a potvrzený milník. Starý splněný bez pole `potvrzeno` platí
       za potvrzený – stejně jako na webu (`potvrzeno !== false`). */
    function milnikPotvrzeny(d) {
      return d.get('hotovo', false) == true && d.get('potvrzeno', true) != false;
    }
    /* Zrušení splnění milníku (`hotovo` z ano na ne) – odmítnutí
       (KB.vratMilnik) i „Vrátit mezi rozdělané". Zpracovatel svůj smí,
       manažer cizí jen s právem potvrzovat milníky (3. 11. 2026). */
    function milnikRusi() {
      return resource.data.get('hotovo', false) == true
        && request.resource.data.get('hotovo', false) != true;
    }

    match /artifacts/firemni-kb-app/public/data/{document=**} {
      // číst smí každý, kdo je v seznamu lidí
      allow read: if clen();
    }

    // --- výkazy práce -------------------------------------------------------
    //
    // Schválně leží mimo `public/data`, a to je celý ten trik. Pravidla se
    // sčítají – jakmile jednou nahoře stojí `allow read: if clen()` pro celý
    // podstrom `public/data/**`, nedá se to níž ničím odebrat. Kdyby výkazy
    // ležely tam, přečetl by si je každý zaměstnanec – stačilo by mu jít na
    // databázi mimo web, kde na něj naše schovaná tlačítka neplatí.
    //
    //   private/vykazy/zaznamy/{id}          odpracovaný čas (bez peněz)
    //   private/vykazy/castky/{id}           sazba a částka k témuž zápisu
    //   private/vykazy/ciselniky/nastaveni   sazby lidí, rozpočty zakázek
    //
    // Peníze jsou v samostatném dokumentu proto, že Firestore neumí schovat
    // jednotlivé pole – kdo dokument přečte, přečte ho celý. Zaměstnanec tak
    // uvidí své hodiny, ale ne to, za kolik se jeho hodina fakturuje.
    // Obojí má stejné `{id}`, takže se to spáruje jedním pohledem.

    /* UZÁVĚRKA. Lhůtu „do úterý příštího týdne" hlídá prohlížeč – spočítat
       ji v pravidlech nejde. Databáze drží TVRDOU čáru: den uzávěrky, který
       nastaví manažer (`public/data/meta/uzaverka.odIso`). Starší dny už
       zaměstnanec nezaloží, nepřepíše ani nesmaže, ani z konzole. Chybějící
       dokument = žádná čára, takže se nic nezamkne omylem.
       (Michal 1. 9. 2026.) */
    function uzaverkaOd() {
      return exists(/databases/$(database)/documents/artifacts/firemni-kb-app/public/data/meta/uzaverka)
        ? get(/databases/$(database)/documents/artifacts/firemni-kb-app/public/data/meta/uzaverka)
            .data.get('odIso', '0000-00-00')
        : '0000-00-00';
    }

    /* ZÁMEK PROPLACENÉHO MĚSÍCE (Michal 3. 11. 2026). Výplata dohodáře,
       OSVČ a studenta má dokument na měsíc – private/vyplaty/mesice/
       {uid}_{RRRR-MM} (výklad u pravidla výplat níž). Jakmile je měsíc
       proplacený nebo ručně uzavřený (`uzavreno` != null), nesmí se zápisy
       ani částky toho člověka v tom měsíci založit, změnit ani smazat –
       ani manažerovi, jinak by přestalo sedět, co se proplatilo. Smí to
       jen hlavní správce (ten smí měsíc i odemknout). Měsíc se bere z data
       zápisu („2026-10-15“[0:7] = „2026-10“). Zápis bez uid nebo data se
       zámkem neřídí; bez dokumentu (zaměstnanec, nespočítaný měsíc) je
       měsíc otevřený. Stojí to jeden dokument navíc, u přesunu zápisu do
       jiného měsíce nebo na jiného člověka dva (starý a nový měsíc). */
    function vyplataCesta(uid, mesic) {
      return /databases/$(database)/documents/artifacts/firemni-kb-app/private/vyplaty/mesice/$(uid + '_' + mesic);
    }
    function mesicOtevreny(d) {
      return !(d.get('uid', '') is string) || d.get('uid', '') == ''
        || !(d.get('datum', '') is string) || d.get('datum', '').size() < 7
        || !exists(vyplataCesta(d.uid, d.datum[0:7]))
        || get(vyplataCesta(d.uid, d.datum[0:7])).data.get('uzavreno', null) == null;
    }

    /* ČÁRA PLATÍ I PRO MANAŽERA (Michal 12. 11. 2026, Iris – uzávěrka
       měsíce). Uzavřený měsíc (datum před `uzaverkaOd()`) nezaloží, nezmění
       ani nesmaže ani manažer – jinak by přestal sedět snímek uzávěrky,
       podle kterého se počítaly mzdy a výplaty. Obchvat má jen hlavní
       správce (ten smí i čáru vrátit = měsíc odemknout). Zápis bez data se
       čárou neřídí, stejně jako v mesicOtevreny – ať manažer smí uklidit
       i rozbitý dokument. Stojí to jedno čtení `meta/uzaverka` navíc. */
    function poCare(d) {
      return !(d.get('datum', '') is string) || d.get('datum', '') == ''
        || d.get('datum', '') >= uzaverkaOd();
    }

    /* TVAR ZÁPISU VÝKAZU (audit 10. 11. 2026, Michal 12. 11. 2026, Iris –
       A1-03, A1-06). Z polí zápisu počítá automat částky a Výplaty, takže
       databáze hlídá i CO se zapisuje, ne jen kdo:
       - klíče jen ty, které píše web (zaznamPayload ve store.js – jediné
         místo, kudy web do `zaznamy` píše; Apps Script ani nástroje na PC
         zápisy nepíšou). U úpravy se hlídají jen ZMĚNĚNÉ klíče – starší
         dokumenty můžou nést pole z dřívějška a setDoc s merge je nechá být;
       - `hodiny` číslo 0–24 (jeden den), `datum` tvar RRRR-MM-DD;
       - placené školení (`absencePlacena`) zapne jen manažer; vlastník ho
         smí nechat, když ho tam manažer už dal, nebo vypnout;
       - vlastník píše `updatedMs` jen kolem času serveru (±10 min) – podle
         něj se řídí dopočet částek i zápis do Tabulek. Manažera se to
         netýká (import starších zápisů). Hlavní správce obchází vše. */
    function vykazKlice() {
      return ['uid', 'osoba', 'datum', 'nazev', 'nazevAuto', 'zakazka', 'projekt', 'firma',
              'cinnost', 'technologie', 'ukolId', 'budova', 'patro', 'podilPatra', 'podilTech',
              'od', 'do', 'pauza', 'hodiny', 'obed', 'km', 'absence', 'absencePlacena', 'ho',
              'zdroj', 'poznamka', 'createdMs', 'createdBy', 'updatedMs', 'updatedBy'];
    }
    function vykazTvarOk(stary) {
      return (stary == null
               ? request.resource.data.keys().hasOnly(vykazKlice())
               : request.resource.data.diff(stary).affectedKeys().hasOnly(vykazKlice()))
        && request.resource.data.get('hodiny', 0) is number
        && request.resource.data.get('hodiny', 0) >= 0
        && request.resource.data.get('hodiny', 0) <= 24
        && request.resource.data.get('datum', '') is string
        && request.resource.data.get('datum', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function vykazPlacenaOk(stary) {
      return request.resource.data.get('absencePlacena', false) != true || spravce()
        || (stary != null && stary.get('absencePlacena', false) == true);
    }
    function vykazCasOk() {
      return request.resource.data.get('updatedMs', 0) is number
        && request.resource.data.get('updatedMs', 0) > request.time.toMillis() - 600000
        && request.resource.data.get('updatedMs', 0) < request.time.toMillis() + 600000;
    }

    match /artifacts/firemni-kb-app/private/vykazy/zaznamy/{id} {
      // svoje vidí každý, cizí jen správce
      allow read:   if spravce() || (clen() && resource.data.uid == request.auth.uid);
      // v uzavřeném (proplaceném) měsíci jen hlavní správce – mesicOtevreny výš
      // od 12. 11. 2026 drží čáru i manažer (poCare výš), obchází ji jen hlavní správce
      // tvar zápisu (vykazTvarOk, vykazPlacenaOk, vykazCasOk) od 12. 11. 2026 – výklad výš
      allow create: if hlavniSpravce() || (mesicOtevreny(request.resource.data)
                       && vykazTvarOk(null) && vykazPlacenaOk(null) && ((spravce()
                       && poCare(request.resource.data)) || (clen()
                       && request.resource.data.uid == request.auth.uid
                       && request.resource.data.datum >= uzaverkaOd()
                       && vykazCasOk())));
      /* Vlastník smí opravit svůj zápis, ale nesmí ho přepsat na někoho
         jiného, přesunout do uzavřeného období ani si dodatečně dopsat
         `zdroj: "panel"`, kterým se odemyká mazání. Z uzavřeného měsíce
         ani do něj nic nepřesune ani manažer. */
      allow update: if hlavniSpravce() || (mesicOtevreny(resource.data) && mesicOtevreny(request.resource.data)
                    && vykazTvarOk(resource.data) && vykazPlacenaOk(resource.data)
                    && ((spravce() && poCare(resource.data) && poCare(request.resource.data)) || (clen()
                       && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid
                       && resource.data.datum >= uzaverkaOd()
                       && request.resource.data.datum >= uzaverkaOd()
                       && request.resource.data.get('zdroj', '') == resource.data.get('zdroj', '')
                       && vykazCasOk())));
      /* Vlastní záznam si člověk smí smazat stejně, jako si ho smí opravit.
         Web mu to pouští jen do půlnoci dne, kdy zápis vznikl (přání Michala
         4. 9. 2026); tvrdou hranicí v databázi je uzávěrka – co je jednou
         uzavřené, nesmaže ani vlastník. Dřív to šlo jen u záznamů
         z Rychlého zápisu (`zdroj: "panel"`). */
      allow delete: if hlavniSpravce() || (mesicOtevreny(resource.data) && ((spravce()
                       && poCare(resource.data)) || (clen()
                       && resource.data.uid == request.auth.uid
                       && resource.data.datum >= uzaverkaOd())));
    }

    /* Částky vidí manažer u všech. OSVČ a student navíc SVOJE – bez toho
       nemají z čeho vystavit fakturu (Michal 2. 9. 2026). Zapisovat je smí
       pořád jen manažer: sazba je jeho rozhodnutí, ne přání toho, komu se
       platí. Zaměstnanci zůstávají částky zavřené jako dřív. */
    match /artifacts/firemni-kb-app/private/vykazy/castky/{id} {
      allow read:  if spravce() || (fakturujeSi()
                      && resource.data.uid == request.auth.uid);
      // v uzavřeném (proplaceném) měsíci jen hlavní správce – mesicOtevreny výš;
      // od 12. 11. 2026 i před čárou uzávěrky jen hlavní správce – poCare výš
      // robot (Apps Script dopočítává částky, zajistiCastku_) stejně jako manažer – 12. 11. 2026
      allow create: if hlavniSpravce() || ((spravce() || robot()) && mesicOtevreny(request.resource.data)
                       && poCare(request.resource.data));
      allow update: if hlavniSpravce() || ((spravce() || robot())
                       && mesicOtevreny(resource.data) && mesicOtevreny(request.resource.data)
                       && poCare(resource.data) && poCare(request.resource.data));
      /* Když si člověk smaže svůj zápis, musí s ním zmizet i jeho částka –
         jinak by v databázi zůstala peněžní věta bez zápisu. Zapisovat
         částky pořád smí jen manažer (4. 9. 2026).
         Vlastník ale smí smazat částku JEN spolu se zápisem (zápis už není,
         nebo mizí ve stejné dávce – existsAfter). Jinak by si smazal ručně
         sníženou částku a dopočet by ji založil znovu podle plné sazby
         (audit 10. 11. 2026 A1-05/A3-05, Michal 12. 11. 2026, Iris). Web
         maže zápis před částkou (KB.deleteVykaz, dávka při zamítnutí). */
      allow delete: if hlavniSpravce() || (mesicOtevreny(resource.data) && ((spravce()
                       && poCare(resource.data)) || (clen()
                       && resource.data.get('uid', '') == request.auth.uid
                       && resource.data.get('datum', '') >= uzaverkaOd()
                       && !existsAfter(/databases/$(database)/documents/artifacts/firemni-kb-app/private/vykazy/zaznamy/$(id)))));
    }

    /* Vlastní sazba. Kdo si fakturuje sám, potřebuje svou sazbu vidět UŽ PŘI
       PSANÍ výkazu, ne až u uloženého zápisu – jinak mu formulář slibuje
       nulu. Číselník `vykazy/ciselniky/nastaveni` mu ukázat nejde: je to
       jeden dokument se sazbami všech lidí a s rozpočty zakázek, a pravidla
       neumí schovat jednotlivé pole. Proto si manažer zrcadlí sazbu každého
       do jeho vlastního dokumentu, kde id dokumentu JE to uid – ověřit
       vlastníka tím jde bez čtení dalšího dokumentu (Michal 13. 10. 2026).
       Zapisuje jen manažer: kolik se za hodinu platí, není přání toho,
       komu se platí. A čte ji JEN ten, kdo si fakturuje sám – zaměstnanec
       má domluvenou měsíční výplatu a hodinovka se mu nikde neukazuje,
       stejně jako u částek. Zrcadlo se mu proto ani nezakládá. */
    match /artifacts/firemni-kb-app/private/sazby/lide/{uid} {
      allow read:  if spravce() || (fakturujeSi() && request.auth.uid == uid);
      allow write: if spravce();
    }

    // --- projekty (dřív „zakázky") --------------------------------------
    //
    //   private/projekty/seznam/{id}    hlavička: název, firma, stav,
    //                                   priorita, termíny, lidé (pole UID)
    //   private/projekty/finance/{id}   příjmy a výdaje – JEN manažeři
    //
    // Zaměstnanec vidí jen projekty, ke kterým je přiřazený – proto leží
    // mimo `public/data` (tam se čtení níž odebrat nedá) a peníze jsou
    // zase ve vedlejším dokumentu, protože pravidla neumí schovat pole.
    // Zápis hlaviček i financí drží spodní pravidlo pro `private` (manažer).

    match /artifacts/firemni-kb-app/private/projekty/seznam/{id} {
      allow read: if spravce() || (clen() && request.auth.uid in resource.data.lide);
    }

    // --- úkoly s TO-DO rozpadem -----------------------------------------
    //
    //   private/ukoly/seznam/{id}    projekt, druh, technologie, budova,
    //                                patro, přiřazení lidé, todo: [{text,pct}]
    //   private/ukoly/budgety/{id}   budget a rezerva hodin – JEN manažeři
    //                                (kryje je spodní pravidlo pro private)
    //
    // Úkol čte každý člen: kdo pomáhal kolegovi, zapisuje si výkaz na jeho
    // úkol a musí ho umět najít. Jde to bezpečně až od chvíle, kdy budget
    // neleží v dokumentu úkolu – pravidla neumí schovat jednotlivé pole,
    // proto je ve vedlejším dokumentu `budgety/{id}` (stejný trik jako
    // výkazy: zaznamy × castky).
    //
    // Postup smí zapisovat jen přiřazený – a jen pole `todo` a `stav`;
    // zadání ani přiřazení mu pravidlo změnit nedovolí. Zakládání a mazání
    // je manažerská práce (spodní pravidlo).

    /* Potvrzení hotového úkolu (`potvrzeno` z ne na ano) – druh `ukoly`
       (KB.potvrdUkol). Úkol z milníku (`milnikId`) potvrdí s milníkem i ten,
       kdo smí potvrzovat milníky (KB.dokonciUkolyMilniku), ale jen když je
       milník v databázi opravdu splněný a potvrzený. Zakládání a mazání
       úkolů je dál jen manažerské; zachytávací pravidlo pro `private` sem
       od 3. 11. 2026 zakládání a změny nepouští, proto `create` tady. */
    function ukolPotvrzuje() {
      return request.resource.data.get('potvrzeno', false) == true
        && resource.data.get('potvrzeno', false) != true;
    }
    /* Vrácení hotového úkolu do práce (`stav` z hotovo na cokoli jiného) –
       odmítnutí (KB.vratUkol). Přiřazený si svůj úkol vrátit smí (sníží
       TO-DO), manažer cizí jen s právem potvrzovat úkoly (3. 11. 2026). */
    function ukolVraci() {
      return resource.data.get('stav', '') == 'hotovo'
        && request.resource.data.get('stav', '') != 'hotovo';
    }
    function milnikCesta(mid) {
      return /databases/$(database)/documents/artifacts/firemni-kb-app/private/milniky/seznam/$(mid);
    }
    function ukolZPotvrzenehoMilniku() {
      return resource.data.get('milnikId', '') is string
        && resource.data.get('milnikId', '') != ''
        && smiPotvrdit('milniky')
        && exists(milnikCesta(resource.data.milnikId))
        && milnikPotvrzeny(get(milnikCesta(resource.data.milnikId)).data);
    }

    match /artifacts/firemni-kb-app/private/ukoly/seznam/{id} {
      allow read: if clen();
      // robot = nástroj na PC (ukoly_zaloha.py: obnova úkolů ze zálohy) – 12. 11. 2026
      allow create: if (spravce() || robot())
                       && (request.resource.data.get('potvrzeno', false) != true || smiPotvrdit('ukoly'));
      allow update: if ((spravce() || robot())
                        && (!ukolPotvrzuje() || smiPotvrdit('ukoly') || ukolZPotvrzenehoMilniku())
                        && (!ukolVraci() || request.auth.uid in resource.data.get('prirazeni', [])
                            || smiPotvrdit('ukoly')))
                    || (clen()
                       && request.auth.uid in resource.data.prirazeni
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['todo', 'stav', 'historie', 'updatedMs', 'updatedBy']));
    }
    // ostatní pod `private/ukoly` (budgety…) zakládá a mění manažer jako dřív
    match /artifacts/firemni-kb-app/private/ukoly/{cast}/{document=**} {
      allow create, update: if (spravce() || robot()) && cast != 'seznam';
    }

    // --- faktury ---------------------------------------------------------
    //
    //   private/faktury/seznam/{id}       faktura (přijatá i vydaná) vč. částek
    //   private/faktury/meta/nastaveni    naše fakturační údaje pro tisk
    //
    // Faktura nese peníze firmy – vidí ji jen hlavní správce, majitel
    // a asistentka (Michal 24. 9. 2026), běžný správce ne. Totéž pokladna
    // (private/pokladna/zaznamy). Spodní zachytávací blok pro `private`
    // je proto obě kolekce vynechává.
    function finance() {
      return clen() && role() in ['hlavni-spravce', 'majitel', 'asistentka'];
    }
    /* Servisní účet, kterým běží nástroje na
       pracovním PC: zakládá doklady z `_inboxu` a jejich náhledy stránek.
       Má roli `spravce`, a ta sem nestačí – běžný správce na faktury nesmí.
       Jmenuje se proto jedním UID a jen tady; na pokladnu se tím nedostane,
       tu nástroje nepotřebují (Michal 9. 10. 2026). Bez tohohle řádku
       končilo nahrávání dokladů na 403 – přišlo se na to až při prvních
       skutečných fakturách, protože schránka byla do té doby prázdná. */
    function robotFaktur() {
      return request.auth != null
        && request.auth.uid == 'ecfzTmq1TMPRHa27agYn8ws0GJm2';
    }
    match /artifacts/firemni-kb-app/private/faktury/{document=**} {
      allow read, write: if finance() || robotFaktur();
    }
    match /artifacts/firemni-kb-app/private/pokladna/{document=**} {
      allow read, write: if finance();
    }

    /* --- výplaty (DPP, DPČ, OSVČ, student) – Michal 3. 11. 2026 ----------
       private/vyplaty/mesice/{uid}_{RRRR-MM}: kolik člověku za měsíc
       vychází, bonusy, proplacení, přenos do dalšího měsíce (tvar ve
       store.js u KB.ulozVyplatu). Jsou to peníze lidí – čte je jen finance
       (hlavní správce, majitel, asistentka), rozesílací účet Apps Scriptu
       (zápis do sešitu) a vlastník SVOJE měsíce. Vlastník se pozná podle
       pole `uid` (web se ptá dotazem uid == já – pravidla nejsou filtr);
       že `uid` a `mesic` sedí s id dokumentu, hlídá zápis, takže id
       dokumentu vždycky začíná uid vlastníka + „_“. Píše jen finance.
       Uzavřený měsíc (`uzavreno` != null) smí měnit – a tím odemknout –
       jen hlavní správce; mazat taky jen on. Zachytávací pravidlo pro
       `private` sem manažera nepouští. Žádné get() navíc (jen záznam
       přihlášeného v users). */
    function vyplataTvar(id) {
      return request.resource.data.get('uid', '') is string
        && request.resource.data.get('mesic', '') is string
        && request.resource.data.mesic.matches('[0-9]{4}-[0-9]{2}')
        && id == request.resource.data.uid + '_' + request.resource.data.mesic;
    }
    match /artifacts/firemni-kb-app/private/vyplaty/mesice/{id} {
      allow read: if finance() || rozesilac()
                     || (clen() && resource.data.uid == request.auth.uid);
      allow create: if finance() && vyplataTvar(id);
      allow update: if (finance() && vyplataTvar(id)
                       && request.resource.data.uid == resource.data.uid
                       && request.resource.data.mesic == resource.data.mesic
                       && (resource.data.get('uzavreno', null) == null || hlavniSpravce()))
                    // rozesílací účet zapíše jen odeslanou výzvu OSVČ k faktuře (12. 11. 2026)
                    || (rozesilac() && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['vyzva', 'updatedMs', 'updatedBy']));
      allow delete: if hlavniSpravce();
    }

    /* --- mzdy zaměstnanců – Michal 12. 11. 2026 (Iris) ------------------
       private/mzdy/lide/{uid}: { historie: [{ od, kc, ms, kdo }], updated* }
       (tvar ve store.js u KB.ulozMzdu). Čte a píše jen finance, maže hlavní
       správce; vlastník svoji mzdu na webu nevidí (jako sazby). Zachytávací
       pravidlo pro `private` sem manažera nepouští (`mzdy` je tam vyjmutá). */
    match /artifacts/firemni-kb-app/private/mzdy/lide/{uid} {
      allow read, create, update: if finance();
      allow delete: if hlavniSpravce();
    }

    /* --- uzávěrka měsíce – Michal 12. 11. 2026 (Iris) ---------------------
       private/uzaverky/mesice/{RRRR-MM}: snímek měsíce pro uzávěrku (hodiny,
       nepřítomnosti, přesčasy, výplaty, rozpočty – tvar ve store.js u
       KB.ulozUzaverkuMesice). Nese peníze lidí i zakázek → čte a píše jen
       finance; rozesílací účet Apps Scriptu čte a mění JEN výsledek
       porovnání sešitů (`sesity`) – dokument nezaloží ani nesmaže. Že pole
       `mesic` sedí s id, hlídá zápis. Uzavřený snímek (`stav` uzavreno)
       mění – a tím odemyká – jen hlavní správce; mazat taky jen on.
       Zachytávací pravidlo pro `private` sem manažera nepouští (kolekce
       `uzaverky` je tam vyjmutá). Žádné get() navíc. */
    match /artifacts/firemni-kb-app/private/uzaverky/mesice/{mesic} {
      allow read: if finance() || rozesilac();
      allow create: if finance() && mesic.matches('[0-9]{4}-[0-9]{2}')
                       && request.resource.data.get('mesic', '') == mesic;
      allow update: if (finance() && request.resource.data.get('mesic', '') == mesic
                        && (resource.data.get('stav', '') != 'uzavreno' || hlavniSpravce()))
                    || (rozesilac() && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['sesity', 'updatedMs', 'updatedBy']));
      allow delete: if hlavniSpravce();
    }

    /* Zůstatky dovolené a přesčasů. SVŮJ vidí každý – je to jeho nárok
       a má si ho hlídat; cizí a zápis jen manažer (spodní pravidlo pro
       `private`). Michal 3. 9. 2026. */
    match /artifacts/firemni-kb-app/private/vykazy/zustatky/{uid} {
      allow read: if spravce() || (clen() && uid == request.auth.uid);
    }

    /* Kontrola týdne: značku „zkontrolováno" u týdne člověka dává a ruší
       manažer (zápis drží spodní pravidlo pro `private`). Člověk čte jen
       SVOJE značky – web se ptá dotazem `uid == já`. Nic nezamyká, zámkem
       je uzávěrka (21. 10. 2026). */
    match /artifacts/firemni-kb-app/private/vykazy/kontrola/{id} {
      allow read: if clen() && resource.data.uid == request.auth.uid;
    }

    /* Nastavení upozornění na e-mail. Mění si ho každý sám; manažer ho
       vidí, ať se dá poradit, proč někomu nic nechodí. Rozesílku dělá
       Apps Script pod svým účtem (Michal 3. 9. 2026). */
    match /artifacts/firemni-kb-app/private/upozorneni/lide/{uid} {
      allow read:  if spravce() || (clen() && uid == request.auth.uid);
      allow write: if clen() && uid == request.auth.uid;
    }

    /* --- porady ---------------------------------------------------------
       Zápis z porady čte celý tým: je to shrnutí toho, co se domluvilo,
       a lidé se na body odkazují. Psát a mazat je smí manažer – to už
       drží spodní pravidlo pro `private`.

       Rozepsaný zápis na PŘÍŠTÍ poradu ale ostatním nic neříká. Manažer ho
       proto může skrýt (`skryto: true`) a web ho členům ani nenačte – ptá
       se dotazem `skryto == false`. Tohle je ta tvrdá půlka: skrytý zápis
       databáze členovi nevydá ani z konzole. Starší zápisy příznak dostaly
       doplněním (KB.doplnSkrytiPorad), nové ho mají vždycky; chybějící
       příznak se bere jako „zveřejněno", ať nic nezmizí (Michal 25. 9. 2026). */
    match /artifacts/firemni-kb-app/private/porady/zapisy/{id} {
      // Jen přihlášený člen – do 20. 10. 2026 tu `clen()` chybělo a zveřejněné
      // zápisy šly přečíst z internetu bez přihlášení (rešerše 19. 10. 2026).
      allow read: if spravce() || (clen() && resource.data.get('skryto', false) != true);
    }

    /* Komentáře k bodům porad. Napsat je smí každý, kdo poradu čte – proto
       má každý komentář vlastní dokument. Kdyby se přidávaly do pole
       v zápisu, musel by mít každý právo přepsat celý zápis.
       Svůj komentář smí autor opravit i smazat, cizí jen manažer. */
    match /artifacts/firemni-kb-app/private/porady/komentare/{kid} {
      allow read:   if clen();
      allow create: if clen() && request.resource.data.uid == request.auth.uid;
      allow update: if clen() && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid;
      allow delete: if spravce() || (clen() && resource.data.uid == request.auth.uid);
    }

    // --- historie aktivit ------------------------------------------------
    // Každý přihlášený zapisuje svoje kroky (jinak by log nešel plnit),
    // ale číst je smí jen manažer – jsou tam i zmínky o výkazech.
    /* Od 12. 11. 2026 (audit 10. 11. 2026 A1-13, Michal, Iris) je kolekce
       vyjmutá ze zachytávacího pravidla pro `private` – dřív přes něj
       správce historii přepsal i smazal a `update, delete: if false` tady
       nic neznamenalo. Zápis jen nový záznam v tvaru, který píše web
       (KB.zapisAktivitu) a nástroje na PC (druh, text, uid, jmeno, ms);
       pod cizím uid nikdo. Záznam „Systém" bez uid (nástroje na PC přes
       kb_api.py) smí jen správce nebo robot. Číst manažer a robot (záloha
       webu), mazat (úklid) jen hlavní správce, měnit nikdo. */
    match /artifacts/firemni-kb-app/private/aktivity/seznam/{id} {
      allow create: if clen()
                       && (request.resource.data.uid == request.auth.uid
                           || ((spravce() || robot()) && request.resource.data.uid == ''))
                       && request.resource.data.keys().hasOnly(['druh', 'text', 'uid', 'jmeno', 'ms'])
                       && request.resource.data.get('text', '') is string
                       && request.resource.data.get('text', '').size() <= 200;
      allow read: if spravce() || robot();
      allow update: if false;
      allow delete: if hlavniSpravce();
    }

    // všechno ostatní v `private` (číselníky se sazbami, rozpočty, finance
    // projektů, zakládání úkolů…) jen správce – kromě faktur, pokladny
    // a výplat (od 12. 11. 2026 i uzávěrek měsíců), které mají vlastní
    // přísnější pravidlo výš (pravidla se
    // sčítají, proto se tu musí vynechat výslovně). Od 3. 11. 2026 navíc:
    // nastavení potvrzování mění jen hlavní správce a úkoly a milníky
    // (`seznam`) zakládá a mění manažer přes vlastní pravidla s hlídáním
    // potvrzení – jinak by je tohle pravidlo pustilo každému manažerovi.
    // Totéž výkazy: zápisy a částky hlídají zámek proplaceného měsíce
    // (mesicOtevreny), zbytek `private/vykazy` má pravidlo hned pod tímhle.
    // Od 12. 11. 2026 (audit 10. 11. 2026, Michal, Iris): vyjmuté i `aktivity`
    // (historie – vlastní pravidlo výš, A1-13) a totéž smí robot (A3-06) –
    // Apps Script a nástroje na PC tu čtou a píšou upozornění, číselníky,
    // projekty, fotky BPH, vybavení, zálohu webu…
    match /artifacts/firemni-kb-app/private/{kolekce}/{document=**} {
      allow read: if (spravce() || robot())
                     && !(kolekce in ['faktury', 'pokladna', 'potvrzovani', 'vyplaty', 'uzaverky', 'aktivity', 'mzdy']);
      allow delete: if (spravce() || robot())
                       && !(kolekce in ['faktury', 'pokladna', 'potvrzovani', 'vyplaty', 'vykazy', 'uzaverky',
                                        'aktivity', 'mzdy']);
      allow create, update: if (spravce() || robot())
                       && !(kolekce in ['faktury', 'pokladna', 'potvrzovani', 'ukoly', 'milniky', 'vyplaty', 'vykazy',
                                        'uzaverky', 'aktivity', 'mzdy']);
    }
    // ostatní pod `private/vykazy` (číselníky, zůstatky, kontrola týdnů, stavy
    // zápisu do Tabulek, přehledy…) zakládá, mění a maže manažer jako dřív;
    // robot (Apps Script) píše stavy zápisu do Tabulek `gsync` – 12. 11. 2026
    match /artifacts/firemni-kb-app/private/vykazy/{cast}/{document=**} {
      allow create, update, delete: if spravce() && !(cast in ['zaznamy', 'castky']);
      allow create, update: if robot() && cast == 'gsync';
    }

    /* Kdo co potvrzuje (výklad nahoře u smiPotvrdit). Číst musí každý člen –
       stránky podle toho ukazují tlačítko Potvrdit, nebo „Potvrzuje: …";
       čte ho i rozesílací účet Apps Scriptu (je to člen). Zapisuje a maže
       jen hlavní správce, a jen v předepsaném tvaru. */
    match /artifacts/firemni-kb-app/private/potvrzovani/{document=**} {
      allow read: if clen();
      allow delete: if hlavniSpravce();
      allow create, update: if hlavniSpravce()
                       && request.resource.data.keys().hasOnly(['druhy', 'updatedMs', 'updatedBy'])
                       && request.resource.data.get('druhy', {}) is map;
    }

    // --- návody: tvořit a upravovat může každý, mazat jen správce ---
    /* Od 12. 11. 2026 (audit 10. 11. 2026 A1-10 a A2-01, Michal, Iris):
       - id obrázku jen [A-Za-z0-9_-]{1,64} (web tvoří „img_<ms>_<n>“) a stejně
         případný klíč `id` v datech – id šlo do HTML (data-img) a s uvozovkou
         z něj byl uložený skript;
       - návod mění jen autor nebo manažer. Autor = `createdUid` (uid, ne
         jméno – pole `author` je volný text z formuláře). Návody bez
         `createdUid` (všechny dosavadní – web ho zatím nezapisuje) dál
         upraví každý člen jako dřív; `createdUid` si nikdo nepřepíše ani
         nepřipíše cizí. Platit to začne, až ho web při založení zapíše. */
    function guideAutorOk(d) {
      return spravce() || !('createdUid' in d) || d.createdUid == request.auth.uid;
    }
    function guideCesta(gid) {
      return /databases/$(database)/documents/artifacts/firemni-kb-app/public/data/guides/$(gid);
    }
    match /artifacts/firemni-kb-app/public/data/guides/{guideId} {
      allow create: if clen() && request.resource.data.get('createdUid', request.auth.uid) == request.auth.uid;
      allow update: if clen() && guideAutorOk(resource.data)
                       && (spravce() || request.resource.data.get('createdUid', '') == resource.data.get('createdUid', ''));
      allow delete: if spravce();

      match /images/{imageId} {
        allow create, update: if clen()
                                 && imageId.matches('^[A-Za-z0-9_-]{1,64}$')
                                 && (!('id' in request.resource.data)
                                     || (request.resource.data.id is string
                                         && request.resource.data.id.matches('^[A-Za-z0-9_-]{1,64}$')))
                                 && (!exists(guideCesta(guideId)) || guideAutorOk(get(guideCesta(guideId)).data));
        allow delete: if spravce();
      }
    }

    /* --- staré úkoly z webu 1.0 -------------------------------------
       Web 2.0 je jen ČTE (stránka Historie); zakládají se úkoly v
       `private/ukoly/seznam`. Zápis sem proto patří jen manažerovi –
       dřív směl kdokoliv přepsat cizí úkol, takže zákaz zakládání
       studentům byl jen kosmetický (Michal 1. 9. 2026). */
    match /artifacts/firemni-kb-app/public/data/tasks/{taskId} {
      allow create, update, delete: if spravce();
    }

    // --- číselníky (zakázky, skupiny) jen správci ---
    match /artifacts/firemni-kb-app/public/data/meta/{docId} {
      // Zapisuje jen správce. Výjimka pro starý dokument `meta/milniky`
      // (kam smel psát každý člen) je pryč od 20. 10. 2026 – milníky žijí
      // v private/milniky a starý dokument už nic nečte ani nepíše.
      // `meta/zpetne` (povolení zpětného zápisu, i jeho zrušení) od 3. 11.
      // 2026 jen ten, kdo smí potvrzovat druh `zpetne`.
      // `meta/uzaverka` (čára) od 12. 11. 2026 (Michal, Iris): správce ji smí
      // jen posunout dopředu (uzavřít další měsíc); zpátky – odemknout měsíc –
      // jen hlavní správce. Jinak by si manažer uzavřený měsíc otevřel sám.
      // `meta/gsync` (adresa Apps Scriptu, na kterou web posílá ID token
      // přihlášeného) od 12. 11. 2026 jen hlavní správce a jen adresa skriptu
      // Googlu (nebo prázdná) – dřív ji přepsal každý správce na svůj server
      // (audit 10. 11. 2026 A1-04, Michal, Iris).
      allow write: if spravce() && (docId != 'zpetne' || smiPotvrdit('zpetne'))
                      && (docId != 'uzaverka' || hlavniSpravce()
                          || request.resource.data.get('odIso', '')
                             >= (resource == null ? '' : resource.data.get('odIso', '')))
                      && (docId != 'gsync' || (hlavniSpravce() && (request.resource == null
                          || request.resource.data.get('url', '') == ''
                          || request.resource.data.get('url', '')
                               .matches('^https://script[.]google[.]com/macros/s/[A-Za-z0-9_-]+/exec$'))));
      // robot: Apps Script píše stav rozesílky (`upozorneni`), nástroj na PC
      // firmy z Pohody do `zakazky` – nic jiného z `meta` (12. 11. 2026, A3-06)
      allow create, update: if robot() && docId in ['upozorneni', 'zakazky'];
    }

    /* --- milníky (harmonogram odevzdání) ---------------------------------
       Dřív pole v `public/data/meta/milniky`, kam vidí každý člen. Od
       8. 10. 2026 je harmonogram celý (příloha smlouvy) a manažer ho
       zveřejňuje postupně, takže nezveřejněný plán nesmí databáze vydat.

       Dva dokumenty se stejným {id}, stejně jako u výkazů:
         seznam/{id}    co milník je – člen čte jen `zverejneno == true`
         terminy/{id}   termín – člen čte jen ten svůj

       Kdo smí termín číst, je vyjmenovaný v `kdoVidiTermin`: prázdné pole =
       nezveřejněno, jinak UID zpracovatelů. Kolega tak uvidí, že milník
       existuje a čí je, ale ne kdy se odevzdává (Michal 8. 10. 2026). */
    match /artifacts/firemni-kb-app/private/milniky/seznam/{id} {
      /* Tři okruhy: manažer vidí všechno, člen zveřejněné milníky kohokoliv
         a navíc VŠECHNY milníky své technologie – i nezveřejněné, aby věděl,
         co po jeho profesi přijde. Termín k nim nedostane, ten má vlastní
         dokument a vlastní seznam (Michal 8. 10. 2026). */
      allow read: if spravce()
                     || (clen() && resource.data.get('zverejneno', false) == true)
                     || (clen() && request.auth.uid in resource.data.get('kdoVidiPostup', []));
      /* Potvrdit milník (druh `milniky`) = dostat ho do stavu splněný
         a potvrzený – potvrzením odškrtnutí od kolegy i manažerovým
         odškrtnutím, které platí rovnou. Úpravy už potvrzeného milníku
         a vrácení mezi rozdělané hlídané nejsou. Mazání jako dřív. */
      allow create: if spravce()
                       && (!milnikPotvrzeny(request.resource.data) || smiPotvrdit('milniky'));
      allow delete: if spravce();
      /* Svůj zveřejněný milník si člen odškrtne sám – ale opravdu jen
         odškrtne. Text, termín ani přiřazení mu pravidla nepustí a
         potvrzení si nechá manažer. `potvrzeno` musí výslovně zůstat
         false (od 3. 11. 2026): splněný milník BEZ pole web bere jako
         starý potvrzený, takže smazáním pole by se člen potvrdil sám.
         `pripraveno*` = „připraveno k odevzdání“ (KB.oznacPripraveno,
         Michal 12. 11. 2026) – i tady člen posílá `potvrzeno: false`. */
      allow update: if (spravce()
                        && (!milnikPotvrzeny(request.resource.data) || milnikPotvrzeny(resource.data)
                            || smiPotvrdit('milniky'))
                        && (!milnikRusi() || request.auth.uid in resource.data.get('zpracovatele', [])
                            || smiPotvrdit('milniky')))
                    || (clen()
                       && resource.data.get('zverejneno', false) == true
                       && request.auth.uid in resource.data.get('zpracovatele', [])
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['hotovo', 'hotovoKdo', 'hotovoMs',
                                      'potvrzeno', 'potvrdil', 'potvrzenoMs',
                                      'pripraveno', 'pripravenoKdo', 'pripravenoMs',
                                      'updatedMs', 'updatedBy'])
                       && request.resource.data.get('potvrzeno', true) == false);
    }
    // ostatní pod `private/milniky` (termíny, párování…) zakládá a mění manažer jako dřív
    match /artifacts/firemni-kb-app/private/milniky/{cast}/{document=**} {
      allow create, update: if spravce() && cast != 'seznam';
    }

    match /artifacts/firemni-kb-app/private/milniky/terminy/{id} {
      allow read:  if spravce() || (clen()
                      && request.auth.uid in resource.data.get('kdoVidiTermin', []));
      allow write: if spravce();
    }

    // --- seznam lidí spravuje jen hlavní správce ---
    match /artifacts/firemni-kb-app/public/data/users/{userId} {
      allow write: if hlavniSpravce();
    }

    // --- plány (podklady pater s živými značkami) -------------------------
    //
    //   private/plany/slozky/{id}                 složky stromu
    //   private/plany/soubory/{id}                hlavička plánu (bez obrázku)
    //   private/plany/soubory/{id}/kousky/{n}     obrázek po kouscích (base64)
    //   private/plany/soubory/{id}/znacky/{zid}   značky se stavem – živě
    //
    // Vidí a upravují všichni členové – parta na patře si značí společně.
    /* Od 12. 11. 2026 (audit 10. 11. 2026 A1-08, Michal, Iris) už ne „každý
       cokoliv". Člen smí jen to, co dělá web: založit složku a plán (obrázek
       po kouscích a dlaždice se nahrávají PŘED hlavičkou, pak už se nemění),
       u plánu měnit společnou paletu a hladiny, kreslit značky pod svým uid
       a měnit značky ostatních bez přepsání autora. Ostatní změny (a mazání)
       jen manažer – přes zachytávací pravidlo pro `private`. Autora plánu
       databáze nezná (pole `kdo` je jméno, ne uid), proto hlavičku kromě
       palety a hladin mění jen manažer – web nic jiného nemění. */
    function planCesta(pid) {
      return /databases/$(database)/documents/artifacts/firemni-kb-app/private/plany/soubory/$(pid);
    }
    match /artifacts/firemni-kb-app/private/plany/{dokument=**} {
      allow read:           if clen();
      // `write` zahrnuje i mazání – jedno kliknutí by smazalo odznačkovanou
      // práci celé party, proto mazání jen manažer (Michal 1. 9. 2026)
      allow delete:         if spravce();
    }
    match /artifacts/firemni-kb-app/private/plany/slozky/{id} {
      allow create: if clen();
    }
    match /artifacts/firemni-kb-app/private/plany/soubory/{planId} {
      allow create: if clen();
      allow update: if clen() && request.resource.data.diff(resource.data).affectedKeys()
                                   .hasOnly(['paleta', 'hladiny']);
    }
    // obrázek plánu – jen při nahrávání, dokud plán nemá hlavičku
    match /artifacts/firemni-kb-app/private/plany/soubory/{planId}/kousky/{n} {
      allow create: if clen() && !exists(planCesta(planId));
    }
    match /artifacts/firemni-kb-app/private/plany/soubory/{planId}/dlazdice/{klic} {
      allow create: if clen() && !exists(planCesta(planId));
    }

    /* Vlastní značku ale smaže i ten, kdo ji nakreslil. Tlačítko × mu ji
       nabízí („cizí značku smaže jen manažer"), jenže pravidlo výš mazání
       zakazovalo úplně všem kromě manažerů – vlastní omyl si tak nikdo
       uklidit nemohl (našlo se 2. 9. 2026, když k značkám přibyly
       obdélníky). Pravidla se sčítají, takže tenhle match jen přidává.
       Od 12. 11. 2026: novou značku jen pod svým uid; cizí značku smí
       člen posunout a přebarvit, ale autora (`uid`) nepřepíše – dřív si ji
       tak přivlastnil a smazal. Stará značka bez uid dostane autora toho,
       kdo ji upraví (web to tak dělá). */
    match /artifacts/firemni-kb-app/private/plany/soubory/{planId}/znacky/{zid} {
      allow create: if clen() && request.resource.data.get('uid', '') == request.auth.uid;
      allow update: if clen() && (request.resource.data.get('uid', '') == resource.data.get('uid', '')
                                  || (resource.data.get('uid', '') == ''
                                      && request.resource.data.get('uid', '') == request.auth.uid));
      allow delete: if clen() && resource.data.get('uid', '') == request.auth.uid;
    }

    /* --- fotky v BPH (přehled po místnostech a technologiích) ------------
       Podklad pro plánování focení: u které místnosti a technologie kolik
       fotek leží. Čte ho celý tým – kdo jede fotit, musí vidět, kde je
       díra. Nahrává ho manažer jedním souborem (spodní pravidlo pro
       `private`), protože data vznikají mimo web, skenem složky s fotkami.

       Schválně pod `private/`, ne v repozitáři: repozitář je veřejný,
       a tohle jsou data ze zakázky. (17. 9. 2026.) */
    match /artifacts/firemni-kb-app/private/fotkybph/{dokument=**} {
      allow read: if clen();
    }

    // --- postup dne (denní screenshoty práce) -----------------------------
    //
    //   private/postup/zaznamy/{uid_datum}            { uid, osoba, datum, text }
    //   private/postup/zaznamy/{uid_datum}/obrazky/{n} { data }  (JPEG base64)
    //
    // Svoje čte a píše každý; cizí vidí jen manažer – je to doklad práce,
    // ne veřejná nástěnka.
    match /artifacts/firemni-kb-app/private/postup/zaznamy/{id} {
      allow read:   if spravce() || (clen() && resource.data.uid == request.auth.uid);
      allow create: if spravce() || (clen() && request.resource.data.uid == request.auth.uid);
      allow update: if spravce() || (clen()
                       && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid);
      allow delete: if spravce();

      match /obrazky/{n} {
        // obrázek nenese uid – právo se bere z rodičovského záznamu
        allow read, write: if spravce() || (clen() &&
            get(/databases/$(database)/documents/artifacts/firemni-kb-app/private/postup/zaznamy/$(id)).data.uid == request.auth.uid);
      }
    }

    // --- info k zakázkám (poznámky z terénu, i z telefonu) ----------------
    //
    //   private/infozakazky/zaznamy/{iz_…}  { uid, jmeno, text, projektId,
    //                                        projektNazev, autoPrirazeno, lide,
    //                                        odkud, vyrizeno…, createdMs, ms }
    //   private/infozakazky/klice/{otisk}   otisk klíče zkratky v telefonu
    //
    // (Michal 12. 11. 2026, Iris.) Manažer a Apps Script (zkratka v telefonu
    // zapisuje přes něj) čtou i píšou ze zachytávacího pravidla `private` výš –
    // tenhle blok jen PŘIDÁVÁ práva členům. Poznámku vidí autor a lidé zakázky
    // (`lide` = autor + lidé projektu, autor tam zůstává vždy); nezařazenou jen
    // autor a manažeři. Zakázku přiřadit a vyřídit smí každý, kdo poznámku
    // vidí; text mění jen autor (a manažer). Klíče (`klice`) nic navíc – vydává
    // je hlavní správce, čte Apps Script.
    match /artifacts/firemni-kb-app/private/infozakazky/zaznamy/{id} {
      // bez pojistky `is list` – jinak dotaz array-contains přes `lide`
      // Firestore neověří (stejně jako u Quick TO-DO)
      allow read: if clen() && (resource.data.uid == request.auth.uid
                                || request.auth.uid in resource.data.lide);
      allow create: if clen()
                       && request.resource.data.uid == request.auth.uid
                       && request.resource.data.lide is list
                       && request.auth.uid in request.resource.data.lide
                       && request.resource.data.text is string
                       && request.resource.data.text.size() >= 1
                       && request.resource.data.text.size() <= 4000
                       && request.resource.data.jmeno is string
                       && request.resource.data.keys().hasOnly(['uid', 'jmeno', 'text', 'projektId',
                            'projektNazev', 'autoPrirazeno', 'lide', 'odkud', 'vyrizeno', 'vyrizenoKdo',
                            'vyrizenoMs', 'createdMs', 'ms', 'upravilUid', 'upravilJmeno']);
      allow update: if clen()
                       && (resource.data.uid == request.auth.uid
                           || request.auth.uid in resource.data.lide)
                       && request.resource.data.uid == resource.data.uid
                       && request.resource.data.get('createdMs', 0) == resource.data.get('createdMs', 0)
                       && request.resource.data.lide is list
                       && resource.data.uid in request.resource.data.lide
                       && request.resource.data.text is string
                       && request.resource.data.text.size() <= 4000
                       && request.resource.data.keys().hasOnly(['uid', 'jmeno', 'text', 'projektId',
                            'projektNazev', 'autoPrirazeno', 'lide', 'odkud', 'vyrizeno', 'vyrizenoKdo',
                            'vyrizenoMs', 'createdMs', 'ms', 'upravilUid', 'upravilJmeno'])
                       // ostatní jen zakázku a vyřízení – cizí text ne
                       && (resource.data.uid == request.auth.uid
                           || request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['projektId', 'projektNazev', 'autoPrirazeno', 'lide',
                                          'vyrizeno', 'vyrizenoKdo', 'vyrizenoMs', 'ms']));
      // mazat jen manažer (zachytávací pravidlo `private`)
    }

    // --- tabule -----------------------------------------------------------
    //
    //   private/tabule/seznam/{id}                hlavička: název, kdo ji
    //                                            založil, viditelnost, proUids
    //   private/tabule/seznam/{id}/content/data   prvky tabule
    //   private/tabule/seznam/{id}/images/{img}   vložené obrázky
    //
    // Tabule se sem stěhovaly z `public/data`. Důvod je volba „vidí ji jen
    // vybraní lidé": v `public/data` stojí nahoře plošné `allow read`, které
    // se níž nedá odebrat, takže by to byla jen schovaná položka v liště.
    // Tady o čtení rozhoduje sama hlavička.
    //
    // Web se proto na tabule ptá třemi dotazy (pro všechny / moje / sdílené
    // se mnou) – pravidla umí dotaz povolit nebo zakázat, ne ho profiltrovat,
    // takže jedna zamčená tabule by jinak strhla celý seznam.

    function tabuleData(id) {
      return get(/databases/$(database)/documents/artifacts/firemni-kb-app/private/tabule/seznam/$(id)).data;
    }

    // Chybějící pole není v pravidlech prázdná hodnota, ale chyba – a chyba
    // znamená zamítnuto. Proto se každé pole nejdřív ověří přes `in`.
    function vidiTabuli(d) {
      return clen() && (
           !('viditelnost' in d) || d.viditelnost != 'vybrani'
        || ('createdUid' in d && d.createdUid == request.auth.uid)
        || ('proUids' in d && d.proUids is list && request.auth.uid in d.proUids)
      );
    }

    match /artifacts/firemni-kb-app/private/tabule/seznam/{id} {
      allow read:   if vidiTabuli(resource.data);
      allow create: if clen() && request.resource.data.createdUid == request.auth.uid;
      /* Od 12. 11. 2026 (audit 10. 11. 2026 A1-09, Michal, Iris): zakladatele
         (`createdUid`) nepřepíše nikdo – dřív si ho kolega přepsal na sebe
         a tabuli smazal; kdo ji vidí a co v ní je (`viditelnost`, `proUids`)
         mění jen zakladatel a manažer. Obsah kreslí dál každý, kdo tabuli
         vidí – tabule je společná. */
      allow update: if vidiTabuli(resource.data)
                       && request.resource.data.get('createdUid', '') == resource.data.get('createdUid', '')
                       && (spravce() || resource.data.get('createdUid', '') == request.auth.uid
                           || !request.resource.data.diff(resource.data).affectedKeys()
                                 .hasAny(['viditelnost', 'proUids']));
      // smazat smí zakladatel a manažer – ne kdokoliv, kdo tabuli vidí
      allow delete: if spravce() || (clen() && resource.data.createdUid == request.auth.uid);

      // obsah a obrázky se řídí viditelností hlavičky – jinak by stačilo
      // sáhnout rovnou na `content/data` a zámek by nebyl k ničemu
      match /{sub=**} {
        allow read, write: if spravce() || vidiTabuli(tabuleData(id));
      }
    }

    // --- kalendář: události, dovolené, nemoci a školení -----------------
    // Vidí je všichni členové (blanket `read` výš), tak jsou schválně
    // v `public/data`. Každý zapisuje svoje; cizí smí měnit jen správce.
    /* Potvrzení nepřítomnosti (dovolená, volno, neplacené volno) – druh
       `nepritomnosti`: `potvrzeno` z ne na ano (KB.potvrdDovolenou), nebo
       nová událost rovnou potvrzená. Když je seznam určených prázdný, smí
       to každý, kdo smí událost zapsat (jako dřív, i vlastník). */
    function kalendarPotvrzuje() {
      return request.resource.data.get('potvrzeno', false) == true
        && (resource == null || resource.data.get('potvrzeno', false) != true);
    }
    function kalendarCesta(kid) {
      return /databases/$(database)/documents/artifacts/firemni-kb-app/public/data/kalendar/$(kid);
    }
    /* Potvrzení převzaté z jiné potvrzené nepřítomnosti TÉHOŽ člověka:
       rozdělená dovolená ve výkazu dostane potvrzení z původní události
       (vykazy.html, planKalendareAbsenci). `potvrzenoZ` = id té události;
       musí existovat, patřit stejnému člověku, být potvrzená a nést stejné
       jméno toho, kdo potvrdil. Tím se dál nerozbije oprava výkazu
       zaměstnanci ani manažerovi, který nepřítomnosti nepotvrzuje. */
    /* Od 12. 11. 2026 (audit 10. 11. 2026 A1-01, Michal, Iris) navíc stejný
       DRUH (`typ`) a ROZSAH: převzaté potvrzení platí jen pro dny, které
       zdrojová událost pokrývá – jinak si zaměstnanec z loňské potvrzené
       dovolené „převzal" potvrzení na libovolné dny.
       Jedna výjimka kvůli tomu, jak web dovolenou dělí (vykazy.html,
       planKalendareAbsenci, smazání dne uprostřed): NEJDŘÍV zkrátí původní
       událost a teprve potom založí druhou část, takže v tu chvíli už
       zdroj druhou část nepokrývá. Druhá část proto projde i jako
       NAVAZUJÍCÍ (kalendarNavazuje): obě z výkazu, začíná po konci zdroje
       a končí nejvýš 31 dní po něm, zdroj je PŮVODNÍ potvrzená událost
       (vznikla před potvrzením: createdMs <= potvrzenoMs) a nová část je
       mladší než potvrzení – z navazující části se tak dál navazovat nedá.
       Až web založí druhou část PŘED zkrácením zdroje, výjimka může pryč. */
    function denMs(s) {
      return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10])).toMillis();
    }
    function jeDen(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function kalendarUvnitr(z, n) {
      return n.get('od', '') != '' && n.get('od', '') >= z.get('od', '')
        && n.get('do', '') <= z.get('do', '');
    }
    function kalendarNavazuje(z, n) {
      return z.get('zdroj', '') == 'vykaz' && n.get('zdroj', '') == 'vykaz'
        && z.get('createdMs', 0) is number && z.get('potvrzenoMs', 0) is number
        && n.get('createdMs', 0) is number
        && z.get('potvrzenoMs', 0) > 0
        && z.get('createdMs', 0) <= z.get('potvrzenoMs', 0)
        && n.get('createdMs', 0) > z.get('potvrzenoMs', 0)
        && jeDen(z.get('do', '')) && jeDen(n.get('od', '')) && jeDen(n.get('do', ''))
        && n.od > z.do
        && denMs(n.do) - denMs(z.do) <= 31 * 86400000;
    }
    function kalendarPrevzatoZ(z, n) {
      return z.get('uid', '') == n.uid
        && z.get('potvrzeno', false) == true
        && z.get('potvrdil', '') == n.get('potvrdil', '')
        && z.get('typ', '') == n.get('typ', '')
        && (kalendarUvnitr(z, n) || kalendarNavazuje(z, n));
    }
    function kalendarPrevzato() {
      return request.resource.data.get('potvrzenoZ', '') is string
        && request.resource.data.get('potvrzenoZ', '').matches('[A-Za-z0-9_-]{1,80}')
        && exists(kalendarCesta(request.resource.data.potvrzenoZ))
        && kalendarPrevzatoZ(get(kalendarCesta(request.resource.data.potvrzenoZ)).data,
                             request.resource.data);
    }
    function kalendarPotvrzeniOk() {
      return !kalendarPotvrzuje() || smiPotvrdit('nepritomnosti') || kalendarPrevzato();
    }
    /* UŽ POTVRZENÁ událost, která potvrzení nese dál (audit 10. 11. 2026
       A1-02, Michal 12. 11. 2026, Iris). Dřív se hlídal jen přechod ne→ano,
       takže potvrzený den šel přepsat na tři týdny nebo školení na
       dovolenou. Kdo nepřítomnosti nepotvrzuje, smí u potvrzené události
       nechat druh a dny, nebo ji ZKRÁTIT (web tak dělí dovolenou při
       smazání dne), a měnit text, čas apod. Vznik, čas potvrzení ani
       jméno potvrzujícího nepřepíše (podle nich se pozná původní událost
       výš). Zrušení potvrzení a smazání se nehlídají jako dřív. */
    function kalendarDrzeniOk() {
      return !(resource.data.get('potvrzeno', false) == true
               && request.resource.data.get('potvrzeno', false) == true)
        || smiPotvrdit('nepritomnosti')
        || (request.resource.data.get('typ', '') == resource.data.get('typ', '')
            && request.resource.data.get('od', '') >= resource.data.get('od', '')
            && request.resource.data.get('do', '') <= resource.data.get('do', '')
            && request.resource.data.get('potvrdil', '') == resource.data.get('potvrdil', '')
            && (!('createdMs' in resource.data)
                || request.resource.data.get('createdMs', 0) == resource.data.createdMs)
            && (!('potvrzenoMs' in resource.data)
                || request.resource.data.get('potvrzenoMs', 0) == resource.data.potvrzenoMs));
    }
    /* Zamítnutí nepřítomnosti (KB.zamitniDovolenou): `zamitnuto` z ne na ano,
       nebo nová událost rovnou zamítnutá – jen kdo nepřítomnosti potvrzuje
       (3. 11. 2026). Zrušení zamítnutí (přeuložení žádosti) se nehlídá,
       stejně jako zrušení potvrzení. */
    function kalendarZamita() {
      return request.resource.data.get('zamitnuto', false) == true
        && (resource == null || resource.data.get('zamitnuto', false) != true);
    }
    function kalendarZamitnutiOk() {
      return !kalendarZamita() || smiPotvrdit('nepritomnosti');
    }

    match /artifacts/firemni-kb-app/public/data/kalendar/{id} {
      allow create: if (spravce() || (clen() && request.resource.data.uid == request.auth.uid))
                       && kalendarPotvrzeniOk() && kalendarZamitnutiOk();
      allow update: if (spravce() || (clen()
                       && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid))
                       && kalendarPotvrzeniOk() && kalendarZamitnutiOk() && kalendarDrzeniOk();
      allow delete: if spravce() || (clen() && resource.data.uid == request.auth.uid);
    }

    // --- auta: rozvrh cest do Brna a rezervace vozů --------------------
    // Vidí to celá firma (blanket `read` výš) – o to jde, aby se dva
    // nedomlouvali na tomtéž autě přes hlavu toho druhého. Zapisuje každý
    // sám za sebe; cizí zápis smaže jen manažer (když někdo zapomene).
    // Kdo veze partu, přihlásí kolegy za ně – proto se nehlídá `uid` (ten,
    // kdo jede), ale `zapsalUid` (kdo zápis pořídil). Smazat smí ten, koho
    // se to týká, ten kdo ho zapsal, a manažer.
    match /artifacts/firemni-kb-app/public/data/auta/{id} {
      allow create: if clen() && request.resource.data.zapsalUid == request.auth.uid;
      allow update: if spravce() || (clen()
                       && resource.data.zapsalUid == request.auth.uid
                       && request.resource.data.zapsalUid == request.auth.uid);
      allow delete: if spravce() || (clen() && (resource.data.uid == request.auth.uid
                                                || resource.data.zapsalUid == request.auth.uid));
    }

    // --- vybavení: rezervace přístrojů (skenery, dálkoměry, notebooky…) ---
    // Seznam přístrojů je dokument public/data/meta/vybaveni – zapisuje ho
    // jen manažer (pravidlo pro meta výš), tady nic dalšího nepotřebuje.
    // Rezervace vidí celá firma (blanket `read` výš), jako auta. Založí si
    // ji každý sám za sebe; upravit a zrušit ji smí autor a manažer.
    match /artifacts/firemni-kb-app/public/data/vybaveni/{id} {
      allow create: if spravce() || (clen() && request.resource.data.uid == request.auth.uid);
      allow update: if spravce() || (clen()
                       && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid);
      allow delete: if spravce() || (clen() && resource.data.uid == request.auth.uid);
    }

    /* Zámky dnů: jeden dokument na přístroj a den, id = "<přístroj>_<den>".
       Web ukládá rezervaci transakcí spolu se zámky všech jejích dnů, takže
       druhá rezervace téhož přístroje na týž den by musela zámek přepsat –
       a to nesmí nikdo, ani manažer. Zámek se jen zakládá a s rezervací
       maže (21. 10. 2026). */
    match /artifacts/firemni-kb-app/public/data/vybaveni-dny/{id} {
      allow create: if clen()
                       && id == request.resource.data.pristrojId + '_' + request.resource.data.den
                       && (spravce() || request.resource.data.uid == request.auth.uid);
      allow update: if false;
      allow delete: if spravce() || (clen() && resource.data.uid == request.auth.uid);
    }

    // --- kdo je právě na webu: každý píše jen svůj otisk ---
    match /artifacts/firemni-kb-app/public/data/pritomnost/{uid} {
      allow write: if clen() && request.auth.uid == uid;
    }

    // --- záznamy přihlášení: zapsat smí každý, mazat nikdo ---
    match /artifacts/firemni-kb-app/public/data/logs/{logId} {
      allow create: if clen();
      allow update, delete: if false;
    }

    // --- Quick TO-DO: rychlé vzkazy mezi dvěma lidmi ---------------------
    // Schválně MIMO `private` – tam má správce plošné čtení, kdežto tohle
    // má vidět jen autor a adresát. Nikdo jiný, ani manažer.
    function quickData(id) {
      return get(/databases/$(database)/documents/artifacts/firemni-kb-app/osobni/quicktodo/seznam/$(id)).data;
    }

    function quickPristup(id) {
      return quickData(id).odKoho == request.auth.uid
             || quickData(id).proUid == request.auth.uid
             || (quickData(id).proUids is list
                 && request.auth.uid in quickData(id).proUids);
    }

    match /artifacts/firemni-kb-app/osobni/quicktodo/seznam/{id} {
      /* Vzkaz může mít víc adresátů – `proUids`. Starší záznamy mají jen
         `proUid`, proto se hlídají obě podoby. Splní-li společný vzkaz
         kdokoliv z adresátů, zhasne všem, takže update musí smět každý
         z nich – ne jen ten, komu „patří". */
      /* U čtení NESMÍ být pojistka `is list`: dotaz array-contains přes
         `proUids` pak Firestore neumí ověřit a celý spadne na právech
         (u jednotlivého dokumentu `in` na ne-seznamu prostě vyjde false). */
      /* Rozesílací účet čte celou kolekci – bez toho nemá z čeho poslat
         „Máš nový Quick TO-DO". Podmínka se schválně neptá na dokument,
         aby prošel i hromadný dotaz (Michal 14. 9. 2026). Pro lidi platí
         dál, co platilo: vzkaz vidí jen autor a adresáti, ani manažer ne. */
      allow read: if rozesilac() || (clen() && (resource.data.odKoho == request.auth.uid
                                || resource.data.proUid == request.auth.uid
                                || request.auth.uid in resource.data.proUids));
      allow create: if clen() && request.resource.data.odKoho == request.auth.uid;
      // přeposlat vzkaz jinému nejde – adresáti ani autor se měnit nesmí
      allow update: if clen()
                       && (resource.data.odKoho == request.auth.uid
                           || resource.data.proUid == request.auth.uid
                           || (resource.data.proUids is list
                               && request.auth.uid in resource.data.proUids))
                       && request.resource.data.proUids == resource.data.proUids
                       // i první adresát `proUid` – podle něj se vzkaz čte a mění,
                       // přepsáním by ho adresát přeposlal třetímu (audit 10. 11. 2026
                       // A1-07, Michal 12. 11. 2026, Iris)
                       && request.resource.data.get('proUid', '') == resource.data.get('proUid', '')
                       && request.resource.data.odKoho == resource.data.odKoho;
      allow delete: if clen() && (resource.data.odKoho == request.auth.uid
                                  || resource.data.proUid == request.auth.uid
                                  || (resource.data.proUids is list
                                      && request.auth.uid in resource.data.proUids));

      /* Screenshoty vzkazu (4. 9. 2026). Obrázek nenese uid – právo se
         bere z vlastního vzkazu, stejně jako u poznámek. Zapisovat smí
         každý, koho se vzkaz týká: autor obrázek přikládá, a kdo vzkaz
         maže, po sobě musí umět uklidit i obrázky. */
      match /obrazky/{n} {
        allow read, write: if clen() && quickPristup(id);
      }
    }

    // --- poznámky = konverzace (chat se screenshoty) ----------------------
    //
    //   osobni/poznamky/listy/{id}                konverzace { nazev, uid =
    //                                             zakladatel, sdileni = ostatní
    //                                             účastníci, posledni*, ztlumili,
    //                                             precteno { uid: ms } }
    //   osobni/poznamky/zaznamy/{id}              zpráva { listId, text, uid =
    //                                             autor, sdileni = účastníci,
    //                                             createdMs… }
    //   osobni/poznamky/zaznamy/{id}/obrazky/{n}  screenshoty (base64)
    //
    // Od 21. 10. 2026 jsou poznámky chat: list = konverzace, poznámka =
    // zpráva (data se nestěhovala). Jako Quick TO-DO schválně MIMO
    // `private` – nevidí je ani manažer. Konverzaci vidí jen její účastníci
    // (zakladatel + `sdileni`), zprávu jen lidé v jejím `sdileni`.
    //
    // `sdileni` zprávy je kopie účastníků konverzace. Musí být přímo ve
    // zprávě, protože pravidla nejsou filtr – dotaz se ptá na pole
    // dokumentu, ne na jiný dokument. Proto ho databáze hlídá: nová zpráva
    // má čtenáře PŘESNĚ jako konverzace a později je jde jen srovnat
    // s konverzací (přidání člověka mu otevře i historii, odebrání ji
    // zavře), ne si je vymyslet.
    //
    // Přidávat lidi smí zakladatel i každý účastník (dřív směl upozornit
    // a tím přisdílet poznámku kdokoliv, kdo ji viděl, a kdo je
    // v konverzaci, je pořád vidět u ní nahoře); odebírat jen zakladatel,
    // sám sebe každý (Opustit).
    //
    // Konverzace a zprávy čte i rozesílací účet Apps Scriptu (rozesilac(),
    // stejně jako Quick TO-DO) – posílá z nich upozornění na nové zprávy
    // (ntfy, e-mail). Není to člověk; manažer ani nikdo jiný to právo nemá.
    //
    // U čtení nesmí být pojistka `is list` – dotaz array-contains přes
    // `sdileni` by pak spadl na právech (stejná past jako u Quick TO-DO).

    function konverzaceCesta(lid) {
      return /databases/$(database)/documents/artifacts/firemni-kb-app/osobni/poznamky/listy/$(lid);
    }
    function konverzace(lid) {
      return get(konverzaceCesta(lid)).data;
    }
    function konverzaceExistuje(lid) {
      return lid is string && lid != '' && exists(konverzaceCesta(lid));
    }
    // zakladatel + ostatní účastníci
    function ucastnici(l) {
      return [l.uid].concat(l.get('sdileni', []));
    }
    function jsemUcastnik(lid) {
      return konverzaceExistuje(lid) && request.auth.uid in ucastnici(konverzace(lid));
    }
    function jsemZakladatel(lid) {
      return konverzaceExistuje(lid) && konverzace(lid).uid == request.auth.uid;
    }
    // dva seznamy se stejnými lidmi (na pořadí a dvojicích nezáleží)
    function stejniLide(a, b) {
      return a is list && b is list && a.hasAll(b) && b.hasAll(a);
    }
    // v seznamu přibyl nebo ubyl jen ten, kdo zapisuje (ztlumení, odchod)
    function zmenaJenJa(stare, nove) {
      return stare is list && nove is list
        && stare.toSet().difference(nove.toSet()).hasOnly([request.auth.uid])
        && nove.toSet().difference(stare.toSet()).hasOnly([request.auth.uid]);
    }
    // z čtenářů ubyl jen ten, kdo zapisuje, a nikdo nepřibyl
    function ubylJenJa(stare, nove) {
      return stare is list && nove is list
        && stare.toSet().difference(nove.toSet()).hasOnly([request.auth.uid])
        && nove.toSet().difference(stare.toSet()).size() == 0;
    }
    // Čas posílá prohlížeč, ale ne z budoucnosti (hodina rezerva na špatně
    // nařízené hodiny). Zpráva z budoucnosti by navždy visela dole a „přečetla"
    // by i zprávy, které po ní teprve přijdou.
    function casOk(t) {
      return t is number && t <= request.time.toMillis() + 3600000;
    }
    function zmenenaPole(nova, stara) {
      return nova.diff(stara).affectedKeys();
    }
    // „přečteno do" (mapa uid → ms): každý mění jen svůj klíč
    function prectenoJenMoje(stare, nove) {
      return stare is map && nove is map
        && nove.diff(stare).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /artifacts/firemni-kb-app/osobni/poznamky/listy/{id} {
      allow read: if rozesilac() || (clen() && (resource.data.uid == request.auth.uid
                                || request.auth.uid in resource.data.sdileni));
      // založit smí každý člen – jen jako zakladatel sám za sebe
      allow create: if clen() && request.resource.data.uid == request.auth.uid
                       && request.resource.data.sdileni is list
                       && request.resource.data.sdileni.size() <= 50
                       && request.resource.data.get('ztlumili', []).size() == 0
                       && request.resource.data.get('precteno', {}).keys().hasOnly([request.auth.uid])
                       && request.resource.data.get('posledniUid', request.auth.uid) == request.auth.uid;
      allow update: if clen()
                       // zakladatel se nemění
                       && request.resource.data.uid == resource.data.uid
                       && request.resource.data.get('sdileni', []) is list
                       && request.resource.data.get('sdileni', []).size() <= 50
                       // ztlumit se smí každý jen sám (i zakladatel)
                       && zmenaJenJa(resource.data.get('ztlumili', []),
                                     request.resource.data.get('ztlumili', []))
                       // přečteno si každý zapisuje jen svoje (i zakladatel)
                       && prectenoJenMoje(resource.data.get('precteno', {}),
                                          request.resource.data.get('precteno', {}))
                       // poslední zprávu hlásí jen její autor a ne z budoucnosti
                       && (!zmenenaPole(request.resource.data, resource.data)
                              .hasAny(['posledniMs', 'posledniUid', 'posledniJmeno', 'posledniText', 'posledniId'])
                           || (request.resource.data.posledniUid == request.auth.uid
                               && casOk(request.resource.data.posledniMs)))
                       && (
                         // zakladatel: název i lidé (přidat i odebrat)
                         resource.data.uid == request.auth.uid
                         || (request.auth.uid in resource.data.sdileni && (
                              // účastník: poslední zpráva, vlastní ztlumení a přečteno
                              // (hlídané výš)
                              zmenenaPole(request.resource.data, resource.data)
                                .hasOnly(['posledniMs', 'posledniUid', 'posledniJmeno', 'posledniText',
                                          'posledniId', 'ztlumili', 'precteno'])
                              // přidat lidi: nikdo neubude
                              || (zmenenaPole(request.resource.data, resource.data).hasOnly(['sdileni'])
                                  && request.resource.data.sdileni.hasAll(resource.data.sdileni))
                              // opustit: ubude jen on sám (a jeho ztlumení)
                              || (zmenenaPole(request.resource.data, resource.data).hasOnly(['sdileni', 'ztlumili'])
                                  && ubylJenJa(resource.data.sdileni, request.resource.data.sdileni))
                            ))
                       );
      // smazat celou konverzaci smí jen zakladatel
      allow delete: if clen() && resource.data.uid == request.auth.uid;
    }

    function poznData(id) {
      return get(/databases/$(database)/documents/artifacts/firemni-kb-app/osobni/poznamky/zaznamy/$(id)).data;
    }

    match /artifacts/firemni-kb-app/osobni/poznamky/zaznamy/{id} {
      allow read: if rozesilac() || (clen() && (resource.data.uid == request.auth.uid
                                || request.auth.uid in resource.data.sdileni));

      // NOVÁ ZPRÁVA: jen účastník konverzace, jen pod svým uid a vidět ji
      // smí přesně účastníci – ani víc, ani míň. Staré komentáře se novým
      // zprávám podstrčit nedají (dají se jen číst u starých poznámek).
      allow create: if clen()
                       && request.resource.data.uid == request.auth.uid
                       && jsemUcastnik(request.resource.data.listId)
                       && stejniLide(request.resource.data.sdileni,
                                     ucastnici(konverzace(request.resource.data.listId)))
                       && casOk(request.resource.data.get('createdMs', 0))
                       && request.resource.data.get('text', '') is string
                       && request.resource.data.get('text', '').size() <= 4000
                       && !('komentare' in request.resource.data)
                       && request.resource.data.get('stav', 0) in [0, 1];

      allow update: if clen()
                       // autor ani konverzace se nemění
                       && request.resource.data.uid == resource.data.uid
                       && request.resource.data.get('listId', '') == resource.data.get('listId', '')
                       && (
        // a) autor: text, štítek a obrázky své zprávy
        (resource.data.uid == request.auth.uid
          && zmenenaPole(request.resource.data, resource.data)
               .hasOnly(['text', 'stav', 'nahled', 'obrazku', 'upraveno'])
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() <= 4000
          && request.resource.data.get('stav', 0) in [0, 1])
        // b) účastník (i čtenář starší přisdílené poznámky): štítek
        //    řeší se / splněno – kdo věc spraví, ten ji zavře
        || ((jsemUcastnik(resource.data.listId) || request.auth.uid in resource.data.sdileni)
          && zmenenaPole(request.resource.data, resource.data).hasOnly(['stav'])
          && request.resource.data.get('stav', 0) in [0, 1])
        // c) přidání člověka: čtenáři = dosavadní + všichni účastníci
        //    konverzace – nikoho, kdo v ní není, tím přidat nejde
        || (jsemUcastnik(resource.data.listId)
          && zmenenaPole(request.resource.data, resource.data).hasOnly(['sdileni'])
          && request.resource.data.sdileni is list
          && request.resource.data.sdileni.hasAll(resource.data.get('sdileni', []))
          && request.resource.data.sdileni.hasAll(ucastnici(konverzace(resource.data.listId)))
          && resource.data.get('sdileni', []).concat(ucastnici(konverzace(resource.data.listId)))
               .hasAll(request.resource.data.sdileni))
        // d) odchod: čtenář smí z čtenářů ubrat jen sám sebe
        || (zmenenaPole(request.resource.data, resource.data).hasOnly(['sdileni'])
          && ubylJenJa(resource.data.get('sdileni', []), request.resource.data.get('sdileni', [])))
        // e) zakladatel konverzace čtenáře jen ubírá (odebral člověka)
        || (jsemZakladatel(resource.data.listId)
          && zmenenaPole(request.resource.data, resource.data).hasOnly(['sdileni'])
          && request.resource.data.sdileni is list
          && request.resource.data.sdileni.toSet()
               .difference(resource.data.get('sdileni', []).toSet()).size() == 0)
                       );

      // smazat smí autor a zakladatel konverzace (úklid celé konverzace);
      // ostatní účastníci cizí zprávy nemažou
      allow delete: if clen() && (resource.data.uid == request.auth.uid
                                  || jsemZakladatel(resource.data.listId));

      match /obrazky/{n} {
        // obrázek nenese uid – právo se bere z rodičovské zprávy
        allow read: if clen() && (poznData(id).uid == request.auth.uid
                                  || request.auth.uid in poznData(id).sdileni);
        // přikládá jen autor zprávy, měnit se nedá
        allow create: if clen() && poznData(id).uid == request.auth.uid;
        // s mazáním zprávy mizí i obrázky – smí ten, kdo smí smazat zprávu
        allow delete: if clen() && (poznData(id).uid == request.auth.uid
                                    || jsemZakladatel(poznData(id).listId));
      }
    }

    // všechno ostatní zavřené
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
